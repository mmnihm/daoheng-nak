# Telegram Bot Token（从 @BotFather 获取，必须用 Secret，不要写入代码）
BOT_TOKEN=123456:ABC-DEF

# 管理员 Telegram Numeric User ID，多个用英文逗号分隔
ADMIN_IDS=123456789

# 备份频道/群的 Chat ID（机器人需为该频道管理员）
# 频道形如 -1001234567890；私聊用户可留空（则备份到与管理员的对话本身）
BACKUP_CHANNEL_ID=-1001234567890

# 可选：保留天数，超过后 /cleanup 可清理（默认 0 = 永久保留）
RETENTION_DAYS=0
