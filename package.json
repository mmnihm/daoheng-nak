{
  "name": "telegram-backup-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram 备份机器人 —— 自动归档文件/消息到备份频道，D1 建立索引，支持统计、搜索、恢复、清理。",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute telegram-backup-bot-db --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "grammy": "^1.38.0"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
